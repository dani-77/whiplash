#!/bin/sh
# whiplash session wrapper: what whiplash.desktop points the greeter at.
#
# dbus-run-session gives the session a real D-Bus session bus, so GTK/Qt
# apps and portals find one from the start. XDG_CURRENT_DESKTOP lets
# xdg-desktop-portal pick a whiplash-specific portals.conf later on.
#
# Output goes to $XDG_STATE_HOME/whiplash/whiplash.log; the previous
# session's log is kept as whiplash.log.old so a crash can be read after
# logging back in.
export XDG_CURRENT_DESKTOP=whiplash
if [ "$#" -ge 2 ] && [ "$1" = --backend ] && [ "$2" = x11 ]; then
    unset WAYLAND_DISPLAY WAYLAND_SOCKET
    export XDG_SESSION_TYPE=x11
    # The X11 login entry starts ATG when the system shell is installed.
    if [ "$#" -eq 2 ] && [ -r /usr/share/quickshell/atg/shell.qml ] &&
        command -v qs >/dev/null 2>&1; then
        export XDG_CONFIG_DIRS="/usr/share:${XDG_CONFIG_DIRS:-/etc/xdg}"
        set -- "$@" -s 'QT_QPA_PLATFORM=xcb qs -n -d -c atg'
    fi
    # D-Bus activation inherits this profile before Whiplash starts.
    export XDG_CONFIG_DIRS="/etc/xdg/whiplash-x11:${XDG_CONFIG_DIRS:-/etc/xdg}"
fi
logdir=${XDG_STATE_HOME:-$HOME/.local/state}/whiplash
mkdir -p "$logdir"
[ -f "$logdir/whiplash.log" ] && mv -f "$logdir/whiplash.log" "$logdir/whiplash.log.old"
exec >"$logdir/whiplash.log" 2>&1
exec dbus-run-session -- whiplash "$@"
